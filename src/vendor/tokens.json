{
  "meta": {
    "name": "Prediforma Design System",
    "version": "0.1.0",
    "prefix": "pf",
    "wcag": "2.1 AA",
    "layers": "global (valores brutos) > alias (semânticos) > component (por componente, só os necessários)",
    "fonte-de-verdade": "Este arquivo. tokens.css é gerado por build-tokens.js. Não editar tokens.css à mão."
  },

  "global": {
    "color": {
      "azul-noite": "#16294A",
      "azul-profundo": "#1F3B67",
      "azul-forte": "#26498A",
      "azul-vivo": "#2C58A3",
      "azul-medio": "#355FAE",
      "azul-estrutural": "#4E78C7",
      "azul-claro-100": "#DCE7F9",
      "azul-claro-50": "#E9F0FC",
      "grafite": "#23262B",
      "grafite-profundo": "#16181C",
      "grafite-suave": "#5B6470",
      "cinza-concreto": "#A9B0B8",
      "cinza-borda": "#D9DDE3",
      "cinza-linha": "#E3E6EA",
      "branco-tecnico": "#F7F8FA",
      "branco": "#FFFFFF",
      "wa-verde": "#25D366",
      "wa-verde-escuro": "#1EBE5A",
      "wa-verde-claro": "#2EE06F",
      "alerta-fundo": "#FFF7E6",
      "alerta-borda": "#F0D9A8",
      "alerta-texto": "#6B4A00"
    },
    "font": {
      "familia-titulo": "Montserrat, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "familia-texto": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "peso-regular": "400",
      "peso-medio": "500",
      "peso-semibold": "600",
      "peso-bold": "700",
      "peso-extrabold": "800"
    },
    "size": {
      "xs": "13px",
      "sm": "14px",
      "base": "16px",
      "md": "18px",
      "lg": "20px",
      "xl": "22px",
      "2xl": "28px",
      "3xl": "32px",
      "4xl": "44px"
    },
    "leading": {
      "justo": "1.15",
      "titulo": "1.2",
      "normal": "1.5",
      "texto": "1.6"
    },
    "space": {
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "7": "48px",
      "8": "64px",
      "9": "96px"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "pill": "999px",
      "full": "50%"
    },
    "stroke": {
      "fino": "1px",
      "medio": "2px",
      "grosso": "4px"
    },
    "shadow": {
      "sm": "0 1px 2px rgba(31, 59, 103, 0.06)",
      "md": "0 1px 2px rgba(31, 59, 103, 0.10), 0 8px 22px rgba(31, 59, 103, 0.12)",
      "lg": "0 18px 40px rgba(22, 41, 74, 0.28)",
      "botao": "0 6px 16px rgba(31, 59, 103, 0.28)",
      "botao-invertido": "0 6px 18px rgba(0, 0, 0, 0.22)",
      "flutuante": "0 2px 4px rgba(0, 0, 0, 0.18), 0 10px 24px rgba(0, 0, 0, 0.22)"
    },
    "motion": {
      "rapido": "150ms",
      "base": "200ms",
      "easing": "cubic-bezier(0.2, 0, 0, 1)"
    },
    "layout": {
      "container": "1200px",
      "gutter-mobile": "16px",
      "gutter-desktop": "24px",
      "leitura": "70ch",
      "bp-sm": "600px",
      "bp-md": "880px",
      "bp-lg": "980px"
    },
    "z": {
      "header": "10",
      "flutuante": "15",
      "pular": "20"
    },
    "target": {
      "min": "44px"
    }
  },

  "alias": {
    "text": {
      "default": "{color.grafite}",
      "muted": "{color.grafite-suave}",
      "heading": "{color.azul-profundo}",
      "link": "{color.azul-medio}",
      "inverse": "{color.branco}",
      "inverse-muted": "{color.azul-claro-50}",
      "footer-muted": "{color.cinza-concreto}",
      "on-whatsapp": "{color.grafite}",
      "alert": "{color.alerta-texto}"
    },
    "surface": {
      "page": "{color.branco}",
      "subtle": "{color.branco-tecnico}",
      "tint": "{color.azul-claro-50}",
      "tint-strong": "{color.azul-claro-100}",
      "inverse": "{color.azul-profundo}",
      "footer": "{color.grafite}",
      "alert": "{color.alerta-fundo}"
    },
    "border": {
      "default": "{color.cinza-borda}",
      "subtle": "{color.cinza-linha}",
      "strong": "{color.cinza-concreto}",
      "accent": "{color.azul-estrutural}",
      "action": "{color.azul-profundo}",
      "alert": "{color.alerta-borda}",
      "whatsapp": "{color.wa-verde-escuro}"
    },
    "accent": {
      "decor": "{color.azul-estrutural}"
    },
    "focus": {
      "ring": "{color.azul-medio}",
      "ring-inverse": "{color.branco}",
      "ring-on-whatsapp": "{color.grafite}"
    },
    "gradient": {
      "marca": "linear-gradient(135deg, {color.azul-estrutural} 0%, {color.azul-profundo} 100%)",
      "botao": "linear-gradient(135deg, {color.azul-profundo} 0%, {color.azul-vivo} 100%)",
      "botao-hover": "linear-gradient(135deg, {color.azul-noite} 0%, {color.azul-forte} 100%)",
      "faixa": "linear-gradient(135deg, {color.azul-noite} 0%, {color.azul-profundo} 55%, {color.azul-vivo} 100%)",
      "cta-final": "linear-gradient(120deg, {color.azul-profundo} 0%, {color.azul-noite} 62%, #101E38 100%)",
      "claro": "linear-gradient(180deg, {color.branco-tecnico} 0%, {color.azul-claro-50} 100%)",
      "icone": "linear-gradient(135deg, {color.azul-claro-50}, {color.azul-claro-100})",
      "barra": "linear-gradient(180deg, #8FB0EA, {color.azul-estrutural})",
      "whatsapp": "linear-gradient(135deg, {color.wa-verde-claro} 0%, {color.wa-verde} 55%, {color.wa-verde-escuro} 100%)",
      "whatsapp-hover": "linear-gradient(135deg, {color.wa-verde}, {color.wa-verde-escuro})",
      "footer": "linear-gradient(180deg, {color.grafite}, {color.grafite-profundo})",
      "hero-luz": "radial-gradient(900px 480px at 88% 12%, rgba(78, 120, 199, 0.30), transparent 60%), radial-gradient(600px 400px at 0% 100%, rgba(31, 59, 103, 0.10), transparent 60%)"
    }
  },

  "component": {
    "button": {
      "height": "48px",
      "height-lg": "56px",
      "padding-x": "{space.5}",
      "padding-y": "{space.3}",
      "radius": "{radius.md}",
      "font-family": "{font.familia-titulo}",
      "font-size": "{size.base}",
      "font-weight": "{font.peso-bold}",
      "gap": "10px",
      "icon-size": "22px"
    },
    "card": {
      "padding": "{space.5}",
      "radius": "{radius.md}",
      "accent-height": "4px",
      "icon-tile": "52px"
    },
    "header": {
      "height": "64px",
      "logo-height": "36px"
    },
    "hero": {
      "padding-y": "{space.8}",
      "padding-y-mobile": "{space.6}",
      "photo-offset": "14px"
    },
    "band": {
      "padding-y": "{space.8}"
    },
    "whatsapp-float": {
      "size": "64px",
      "size-mobile": "60px",
      "offset": "20px",
      "offset-mobile": "16px",
      "icon-size": "34px"
    }
  }
}
